<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Venta directa (Developer ID, notarizada): hardened runtime sin sandbox. -->
    <!-- Con el hardened runtime, leer la selección del Finder por AppleScript exige este permiso. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
